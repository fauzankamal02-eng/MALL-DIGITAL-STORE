# GEMINI_API_KEY: Optional Gemini AI API key if AI features are enabled later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DOWNLOAD_SIGNING_SECRET: HMAC secret for signing automatic digital download links.
DOWNLOAD_SIGNING_SECRET=

# BACKUP_ENCRYPTION_KEY: 32-byte hex or passphrase key for AES-256-GCM encrypted cloud backups.
BACKUP_ENCRYPTION_KEY=

# PAYMENT_GATEWAY_SERVER_KEY: Optional Midtrans/Xendit/Tripay server key for production payment gateway integration.
PAYMENT_GATEWAY_SERVER_KEY=

# PAYMENT_WEBHOOK_SECRET: Optional HMAC-SHA256 secret for verifying incoming POST /api/webhooks/payment callbacks.
PAYMENT_WEBHOOK_SECRET=

# DIGIFLAZZ_USERNAME & DIGIFLAZZ_API_KEY: Optional H2H supplier credentials for live automated Pulsa, PLN, E-Wallet, Game, PDAM & BPJS fulfillment.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=

# RESEND_API_KEY: Optional Resend API key for sending real automated email receipts & digital access links to buyer inboxes.
RESEND_API_KEY=

